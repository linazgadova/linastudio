# ================================================================
# ПРАВИЛА СЕРВЕРА
#
# То же самое, что раньше делали настройки Cloudflare, но словами,
# которые понимает Apache на обычном хостинге.
#
# Здесь три вещи, без которых сайт разваливается незаметно:
# адреса без .html, настоящий код 404 и единственный адрес у каждой
# страницы. Всё остальное — заголовки и кеш.
# ================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# ── ЕДИНСТВЕННЫЙ АДРЕС ──────────────────────────────────────────
# Одна и та же страница не должна открываться по четырём адресам:
# http и https, с www и без. Для поисковика это четыре копии, и
# он сам выбирает главную — обычно не ту, что в canonical.
# Приводим всё к https без www, постоянным перенаправлением.

# Сначала www, потом протокол, и порядок здесь имеет значение.
# Обратный порядок тоже приводит к нужному адресу, но за два
# перенаправления: http://www → https://www → https://. Оба
# поисковика считают длину такой цепочки, а лишнее звено ещё и
# теряет часть веса ссылки. Правило про www ведёт сразу на https,
# поэтому любой из четырёх адресов доходит за один шаг.
# Имя берётся до двоеточия, и это не украшательство. Перед Apache
# здесь стоит другой сервер, и в заголовке Host он оставляет порт:
# правило с обычным %{HTTP_HOST} уводило на https://linastudio.ru:443/.
# Страница по такому адресу открывается та же, но в глазах поисковика
# это другая строка, не совпадающая ни с canonical, ни с картой сайта.
RewriteCond %{HTTP_HOST} ^www\.([^:]+) [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Три условия, а не одно, и это не перестраховка. На хостинге
# шифрование часто снимает не сам Apache, а сервер перед ним —
# тогда %{HTTPS} для Apache выключено даже на https-запросе, и
# правило с одним условием отправляет страницу в вечный круг
# перенаправлений на саму себя.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{SERVER_PORT} !=443
RewriteCond %{HTTP_HOST} ^([^:]+)
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ── БЛОК С ВОПРОСАМИ ────────────────────────────────────────────
# Страница обращается к /api/ask, обслуживает его один файл.
RewriteRule ^api/ask/?$ /api/ask.php [L]

# ── АДРЕСА БЕЗ РАСШИРЕНИЯ ───────────────────────────────────────
# /work/pifika отдаётся файлом work/pifika.html, /en — файлом
# en.html. Именно без перенаправления: канонический адрес в разметке
# стоит без .html, и отвечать на него переездом значит объявлять
# главной копией адрес, который сам же никуда не ведёт.
#
# Проверки «это не папка» здесь намеренно нет, и это важно.
# У английской версии адрес /en, а рядом лежит папка /en/ с её
# проектами. С такой проверкой правило пропускало /en как папку,
# дальше Apache уводил на /en/, где никакой страницы нет, — и
# английская главная отвечала запретом доступа вместо страницы.
#
# Без проверки правило всё равно безопасно: второе условие требует,
# чтобы файл $1.html существовал. Нет страницы — правило молчит.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# ── ПАПКА — НЕ АДРЕС ────────────────────────────────────────────
# /work/, /assets/, /clips/ это места хранения, а не страницы.
# Без этого правила Apache отвечает на них запретом доступа: код 403
# говорит «сюда нельзя», хотя правда в том, что тут ничего и нет.
# Поисковик разбирает эти два ответа по-разному, и 403 на десятке
# адресов выглядит как сайт с закрытыми разделами.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]
</IfModule>

# Страница, которой нет, — с настоящим кодом 404, а не с двухсотым.
# Успешный ответ по выдуманному адресу поисковик заносит в индекс
# как ещё одну страницу с пустым содержимым.
ErrorDocument 404 /404.html

# ── ЗАГОЛОВКИ ───────────────────────────────────────────────────
# Ни одно правило не ограничивает то, что сайт делает сам: скрипты,
# шрифты и картинки не тронуты намеренно. Запрещено только то, чего
# сайт не делает никогда.
<IfModule mod_headers.c>
  # Не угадывать тип файла по содержимому
  Header always set X-Content-Type-Options "nosniff"

  # Чужому сайту уходит имя домена, но не адрес страницы
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Ни камеры, ни микрофона, ни геопозиции сайту не нужно
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

  # Только https, год. Браузер, однажды получивший эту строку,
  # больше не пойдёт на http даже по прямой ссылке
  Header always set Strict-Transport-Security "max-age=31536000"

  # Сайт нельзя вставить в рамку на чужой странице
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

  # Открытая нами вкладка не получает доступа к нашему окну
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # Страницы кешировать нельзя: адрес постоянный, содержимое
  # меняется с каждой сборкой
  <FilesMatch "\.(html|xml|txt|json|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ── СЖАТИЕ ──────────────────────────────────────────────────────
# Текст ужимается втрое-вчетверо. Картинки и ролики уже сжаты,
# их трогать бессмысленно — процессор потратится, размер не изменится.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2 application/manifest+json
</IfModule>

# ── ЗАКРЫТОЕ ────────────────────────────────────────────────────
# Служебные файлы наружу не отдаём. Настройки самого Apache — тем более.
#
# Два написания одного и того же: Require появился в Apache 2.4,
# на 2.2 он не команда, а ошибка, от которой сервер отдаёт 500 на
# весь сайт. Проверка по модулю выбирает нужное само.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Настройки с ключом модели — запрет на прямой запрос.
#
# Сейчас по адресу /api/config.php и так приходит пустая страница:
# PHP выполняет файл, а `return` наружу ничего не печатает. Но держится
# это на одном допущении — что PHP в этой папке работает. Отключат его
# при переезде, сменят тариф, ошибётся кто-нибудь в настройках — и тот
# же самый файл поедет посетителю обычным текстом, вместе с ключом.
#
# Правило работает на уровне запросов и на чтение файла с диска не
# влияет: ask.php подключает его через require и получает как раньше.
<FilesMatch "^config\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Типы, которые старый Apache не знает и потому отдаёт как текст
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType video/webm .webm
  AddType font/woff2 .woff2
</IfModule>
