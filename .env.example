# Образец. Сам .env в git не попадает — за этим следит .gitignore.
#
# Для сборки и запуска сайта переменные не нужны вовсе:
# npm run dev и npm run pack работают без них.
#
# Ключ к модели, которая отвечает в блоке «спросите обо мне»,
# живёт не здесь, а на сервере — в api/config.php. Он не проходит
# через сборку и не попадает ни в один файл, который заливается.
# Образец этого файла: public/api/config.example.php
#
# Здесь остаётся только то, что нужно на своей машине.

# Мост к модели для npm run dev. На боевом сайте вопросы обслуживает
# api/ask.php, а в dev-сервере PHP нет — плагин ask-bridge повторяет
# ту же ручку в Node. Подойдёт любой адрес формата OpenAI.
# Без ключа блок с вопросами работает поиском по данным сайта.
ASK_API_KEY=
ASK_BASE_URL=
ASK_MODEL=

# Уведомление поисковиков об изменившихся адресах (npm run ping).
# Ключ публичный по устройству протокола: он же лежит файлом
# в корне сайта, иначе IndexNow не примет запрос. Значение
# прописано в src/data/seo.ts, переменная нужна, только если
# захочется его переопределить.
INDEXNOW_KEY=
